# ---- Slack (create the app from manifests/slack-app.yaml) ----
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...           # app-level token with connections:write, for Socket Mode

# ---- GitHub: choose ONE of the two auth modes ----
# Quick start: a fine-grained PAT with Issues (read/write), Contents (read/write), Metadata (read)
GITHUB_TOKEN=github_pat_...
# Upgrade: a GitHub App (create from manifests/github-app.json), leave GITHUB_TOKEN empty
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=/data/swatter.private-key.pem
# GITHUB_APP_INSTALLATION_ID=7891011

# Repo used by channels that have not run /swatter connect (optional)
GITHUB_DEFAULT_REPO=owner/repo

# ---- LLM: any OpenAI-compatible endpoint ----
# Anthropic
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001
# Optional JSON object of extra headers. Needed for an organisation-level Anthropic key:
# LLM_EXTRA_HEADERS={"anthropic-workspace-id": "wrkspc_..."}
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1/      LLM_MODEL=gpt-4o-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1/   LLM_MODEL=anthropic/claude-haiku-4.5
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1/       LLM_MODEL=llama3.1:8b   LLM_API_KEY=ollama

# ---- Embeddings ----
EMBEDDING_PROVIDER=fastembed                 # fastembed (local, no key) | endpoint
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# For EMBEDDING_PROVIDER=endpoint (OpenAI, Ollama, etc.)
# EMBEDDING_BASE_URL=http://localhost:11434/v1/
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text

# ---- Swatter behaviour (defaults shown) ----
SWATTER_DB_PATH=data/swatter.db
SWATTER_POLL_INTERVAL_SECONDS=120
SWATTER_CLOSED_LOOKBACK_DAYS=30
SWATTER_CLARIFICATION_TIMEOUT_MINUTES=30
SWATTER_MAX_CLARIFICATION_QUESTIONS=3
SWATTER_MAX_CANDIDATES=3
SWATTER_ASSETS_BRANCH=swatter-assets
SWATTER_LOG_LEVEL=INFO
